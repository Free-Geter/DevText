{
  "manifest_version": 3,
  "name": "DevText 工具箱",
  "version": "1.0.0",
  "description": "开发者文本工具箱，支持 JSON 格式化/修复/可视化、文本差异对比",
  "permissions": ["clipboardRead", "clipboardWrite"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DevText 工具箱"
  }
}
